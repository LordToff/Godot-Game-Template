extends SceneTree
const W = preload("res://prototype/bugh.gd")
const B = preload("res://prototype/battle.gd")
var checks := 0
var failures := 0
func check(ok: bool, why: String):
 checks += 1
 if not ok:failures += 1;printerr("WARDEN FAIL: ",why)
func fresh():
 var g = W.new();g.start([B.default_build(),B.default_build(),B.default_build()],21)
 g.active = 0;g.cursor = g.order.find(0);g.pending = {}
 for h in g.heroes:h.reaction = [];h.used = [false,false,false];h.results = [1,4,2];h.rolls = [0,0,0]
 g.heroes[0].pos = Vector2i(2,3);g.heroes[1].pos = Vector2i(0,8);g.heroes[2].pos = Vector2i(8,8)
 return g
func attack(g, action: String):
 g.active = 3;g.boss_index = 0;g.boss_rolls = [action,"Bound","Bound"];g.boss_step()
func start_boss(g):
 g.order = [3,0,1,2];g.cursor = 0;g.pending = {};g.activate()
func _initialize():call_deferred("run")
func run():
 var g = fresh()
 check(g.boss_name().contains("Iron Warden") and g.minions.is_empty(),"new boss identity without cocoons or summons")
 check(g.phase_upgrades().size() == 6,"six distinct Warden abilities upgrade")
 var hp: int = g.boss.hp
 for hit in range(15):g.damage(3,1,false,"Standing attack")
 check(g.boss.hp == hp,"standing and repeating ordinary attacks cannot beat intact Bulwark")
 g.heroes[0].block = 1;g.boss.block = 4;attack(g,"Shield Bash")
 check(g.guard_broken and g.heroes[0].hp == 6 and g.boss.block == 0,"full guard prevents damage and removes Bulwark and boss Block")
 g.action_owner = 0;g.damage(3,2)
 check(g.boss.hp == hp-2,"counterattack deals full normal damage during opening")
 start_boss(g);check(not g.guard_broken,"opening expires at next boss activation")
 g = fresh();g.heroes[0].block = 1;attack(g,"Hammerfall")
 check(not g.guard_broken and g.heroes[0].hp == 5,"partial block is useful but does not earn a perfect guard")
 g = fresh();g.heroes[0].dr = 1;attack(g,"Shield Bash")
 check(g.guard_broken and g.heroes[0].hp == 6,"Damage Reduction defense can earn an opening")
 g = fresh();g.heroes[0].defy = true;g.heroes[0].hp = 1;attack(g,"Hammerfall")
 check(not g.guard_broken and g.heroes[0].hp == 1,"Defy Death is not falsely counted as guarding with Block or reduction")
 g = fresh();g.heroes[0].results[0] = 5;g.heroes[0].reaction = [0];g.heroes[0].used[0] = true
 attack(g,"Hammerfall");check(g.pending.get("kind","") == "reaction","real reaction window before a heavy attack")
 g.react(true);check(g.guard_broken and g.heroes[0].hp == 6,"actual starter Reaction fully blocks Hammerfall and exposes boss")
 g = fresh();g.arm_sweep();var marked: Array = g.sweep_tiles.duplicate();hp = g.heroes[0].hp
 check(g.heroes[0].pos in marked and g.sweep_damage == 1,"adjacent hero gets a visible phase-I warning")
 g.heroes[0].pos = Vector2i(1,3);start_boss(g)
 check(g.sweep_due and not g.guard_broken,"warning remains until explicitly resolved before dice")
 g.boss_step()
 check(g.guard_broken and g.heroes[0].hp == hp and g.sweep_tiles.is_empty() and g.boss_index == 0,"real movement evades fixed sweep, opens guard, and preserves all three dice")
 g = fresh();g.arm_sweep();start_boss(g);g.boss_step()
 check(g.heroes[0].hp == 5 and not g.guard_broken,"ignoring sweep hurts and does not expose the boss")
 g = fresh();g.arm_sweep();g.heroes[0].block = 2;start_boss(g);g.boss_step()
 check(g.guard_broken and g.heroes[0].hp == 6,"prepared Block is an alternative to dodging the sweep")
 g = fresh();g.heroes[0].results[0] = 5;g.heroes[0].reaction = [0];g.heroes[0].used[0] = true;g.arm_sweep();start_boss(g);g.boss_step()
 check(g.pending.get("kind","") == "reaction","sweep impact offers a Reaction")
 g.react(true);check(g.guard_broken and g.heroes[0].hp == 6 and g.sweep_tiles.is_empty(),"sweep Reaction resolves and clears warning")
 g = fresh();g.heroes[0].results[0] = 2;g.heroes[0].reaction = [0];g.heroes[0].used[0] = true;g.heroes[0].smoke[0] = 2
 g.arm_sweep();start_boss(g);g.boss_step();g.react(true,Vector2i.LEFT)
 check(g.heroes[0].pos == Vector2i(1,3) and g.heroes[0].hp == 6 and g.guard_broken,"movement Reaction can escape a fixed area and earn an opening")
 g = fresh();g.heroes[0].pos = Vector2i(0,8);g.arm_sweep();start_boss(g);g.boss_step()
 check(not g.guard_broken,"a sweep that never threatened a hero grants no free opening")
 g = fresh();g.arm_sweep();marked = g.sweep_tiles.duplicate();g.damage(3,6,true)
 check(g.phase_two and g.sweep_tiles == marked and g.sweep_damage == 1,"phase change does not retroactively widen or strengthen armed warnings")
 g.sweep_tiles.clear();g.arm_sweep();check(g.sweep_damage == 2 and g.sweep_tiles.size() > marked.size(),"new phase-II sweep is wider and stronger")
 g = fresh();g.active = 3;g.boss_index = 3;g.finish_turn()
 check(not g.sweep_tiles.is_empty(),"every completed boss turn leaves a warning even without a Sweep die")
 g = fresh();g.boss.weak = true;g.heroes[0].block = 2;attack(g,"Shield Bash")
 check(not g.guard_broken and g.heroes[0].block == 2,"a zero-damage weakened attack cannot fake a perfect guard")
 g = fresh();var origin: Vector2i = g.heroes[0].pos;attack(g,"Driving Blow")
 check(g.heroes[0].hp == 5 and g.heroes[0].pos != origin,"HP-damaging driving blow pushes")
 g = fresh();origin = g.heroes[0].pos;g.heroes[0].block = 1;attack(g,"Driving Blow")
 check(g.heroes[0].pos == origin and g.guard_broken,"guarding driving blow prevents displacement")
 g = fresh();var worm: int = g.spawn_friendly(0,Vector2i(2,4));g.unit_data(worm).pos = Vector2i(2,3);g.heroes[0].pos = Vector2i(0,7)
 attack(g,"Shield Bash");check(g.unit_data(worm).dead and not g.guard_broken,"a friendly worm is a legal victim but cannot earn a hero perfect guard")
 g = fresh();g.break_guard("test opening",0);worm = g.spawn_friendly(0,Vector2i(2,4));g.balance["face59.hit_faces"] = 6;hp = g.boss.hp;g.activate_friendly(worm)
 check(g.boss.hp == hp-1 and g.boss.poison == 1,"friendly Nu’gh can damage and poison exposed Warden")
 start_boss(g);check(g.boss.hp == hp-2 and g.boss.poison == 0,"existing Poison bypasses renewed Bulwark and clears")
 g = fresh();g.active = 3;attack(g,"Raise Guard")
 check(g.boss.block == 1 and not g.guard_broken,"phase-I Raise Guard grants one Block")
 g.break_guard("test",0);attack(g,"Raise Guard")
 check(g.guard_broken and g.boss.block == 1,"Raise Guard cannot prematurely restore Bulwark")
 g = fresh();g.heroes[0].pos = Vector2i(0,0);var before_move: Vector2i = g.boss.pos;attack(g,"Iron Advance")
 check(g.boss.pos != before_move,"Iron Advance moves the full legal boss footprint")
 g = fresh();g.heroes[1].pos = Vector2i(3,2);attack(g,"Hammerfall")
 check(g.heroes[0].hp == 4 and g.heroes[1].hp == 4,"Hammerfall attacks multiple nearby heroes")
 g = fresh();g.damage(3,6,true)
 check(g.phase_two and g.w("advance","advance_phase") == 2 and g.w("bash_damage","bash_damage_phase") == 2,"phase-II advance and bash upgrade")
 check(g.boss_range("Hammerfall") == 2 and g.w("block","block_phase") == 2,"phase-II reach and guard upgrade")
 check(g.w("drive_damage","drive_damage_phase") == 2 and g.w("push","push_phase") == 2,"phase-II driving blow upgrades damage and push")
 g.boss.hp = g.boss.max_hp;g.check_phase();check(g.phase_two,"healing cannot reverse phase upgrades")
 g = W.new();g.start([B.default_build(),B.default_build(),B.default_build()],21,false,true,{"bugh.initial_cocoons":9,"bugh.mite_hp":99,"warden.armor":3})
 check(g.minions.is_empty() and g.v("warden.armor") == 3,"legacy profiles cannot revive cocoons and active Workshop override works")
 print("V0.24 WARDEN: ",checks," checks, ",failures," failures")
 quit(1 if failures else 0)
